<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title>TOM FORD BEAUTY — INDISCREET</title>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/tone/14.8.49/Tone.js"></script>
    <style>
        /* ==========================================================================
           1. BRAND SYSTEM TOKENS & RESET
           ========================================================================== */
        :root {
            --bg-pure: #FFFFFF;
            --bg-ivory: #F9F9F7;
            --tf-obsidian: #000000;
            --tf-gold: #B59A57;
            --tf-crimson: #63000E;
            --tf-muted: #7C7A75;
            --border-hairline: #E6E6E2;
            color-scheme: light;
        }

        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            -webkit-font-smoothing: antialiased;
        }

        html {
            background: var(--bg-pure);
            scroll-behavior: smooth;
        }

        body {
            background: var(--bg-pure);
            color: var(--tf-obsidian);
            font-family: Arial, "Helvetica Neue", Helvetica, sans-serif;
            letter-spacing: 0.14em;
            overflow-x: hidden;
        }

        /* ==========================================================================
           2. MINIMAL STICKY HEADER
           ========================================================================== */
        nav.site-nav {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 90;
            background: rgba(255, 255, 255, 0.94);
            backdrop-filter: blur(8px);
            border-bottom: 1px solid var(--border-hairline);
            padding: 18px clamp(24px, 5vw, 72px);
            display: flex;
            justify-content: space-between;
            align-items: center;
            opacity: 0;
            pointer-events: none;
            transform: translateY(-6px);
            transition: opacity 0.35s ease, transform 0.35s ease;
        }

        nav.site-nav.visible {
            opacity: 1;
            pointer-events: auto;
            transform: translateY(0);
        }

        .nav-brand {
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.24em;
            color: var(--tf-obsidian);
            text-decoration: none;
        }

        .nav-brand span {
            color: var(--tf-gold);
            margin-left: 10px;
        }

        .nav-links {
            display: flex;
            gap: clamp(18px, 3.5vw, 40px);
        }

        .nav-links a {
            font-size: 9px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.2em;
            color: var(--tf-muted);
            text-decoration: none;
            transition: color 0.2s ease;
        }

        .nav-links a:hover {
            color: var(--tf-obsidian);
        }

        @media (max-width: 680px) {
            .nav-links { display: none; }
        }

        /* ==========================================================================
           3. SECTION I: DYNAMIC HERO STAGE
           ========================================================================== */
        .hero-stage {
            position: relative;
            width: 100%;
            height: 100vh;
            min-height: 600px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            background: radial-gradient(circle at 50% 50%, #FFFFFF 0%, #FAF9F6 74%, #F2F1EC 100%);
            overflow: hidden;
            user-select: none;
            -webkit-user-select: none;
        }

        #heroFxCanvas {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            z-index: 2;
            pointer-events: none;
        }

        .hero-frame {
            position: absolute;
            inset: clamp(14px, 2.5vw, 28px);
            border: 1px solid rgba(181, 154, 87, 0.28);
            pointer-events: none;
            z-index: 5;
        }

        .logo-lockup {
            position: relative;
            z-index: 12;
            text-align: center;
            padding: 24px;
            display: flex;
            flex-direction: column;
            align-items: center;
            transition: transform 0.22s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .logo-brand {
            font-size: clamp(32px, 5.8vw, 76px);
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.32em;
            padding-left: 0.32em;
            color: var(--tf-obsidian);
            line-height: 1;
            margin-bottom: clamp(14px, 2.2vh, 22px);
        }

        .logo-sub {
            font-size: clamp(38px, 8.2vw, 118px);
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.16em;
            padding-left: 0.16em;
            line-height: 0.96;
            background: linear-gradient(110deg, #9A7F3E 0%, #B59A57 28%, #E7D399 48%, #B59A57 68%, #9A7F3E 100%);
            background-size: 220% auto;
            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent;
            animation: goldShimmer 7s ease-in-out infinite;
        }

        @keyframes goldShimmer {
            0%, 100% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
        }

        .hero-scroll-link {
            position: absolute;
            bottom: clamp(28px, 4.5vw, 48px);
            z-index: 15;
            font-size: 8px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.32em;
            color: var(--tf-muted);
            text-decoration: none;
            border-bottom: 1px solid var(--tf-gold);
            padding-bottom: 5px;
            transition: color 0.2s ease;
        }

        .hero-scroll-link:hover {
            color: var(--tf-obsidian);
        }

        /* ==========================================================================
           4. SECTION II: STANDALONE FULL-SCREEN CAMPAIGN IMAGE (UNDERNEATH HERO)
           ========================================================================== */
        .campaign-hero-media {
            position: relative;
            width: 100%;
            height: 100vh;
            min-height: 600px;
            background: var(--tf-obsidian);
            overflow: hidden;
            cursor: zoom-in;
        }

        .campaign-hero-media img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
            transition: transform 1.2s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .campaign-hero-media:hover img {
            transform: scale(1.018);
        }

        /* ==========================================================================
           5. SHARED LUXURY EDITORIAL SECTION ARCHITECTURE
           ========================================================================== */
        .luxury-section {
            max-width: 1240px;
            margin: 0 auto;
            padding: clamp(120px, 15vw, 210px) clamp(24px, 6vw, 72px);
            border-top: 1px solid var(--border-hairline);
        }

        .section-header {
            text-align: center;
            margin-bottom: clamp(72px, 10vw, 120px);
        }

        .section-kicker {
            font-size: 9px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.3em;
            color: var(--tf-gold);
            margin-bottom: 14px;
        }

        .section-heading {
            font-size: clamp(26px, 4vw, 44px);
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.14em;
            color: var(--tf-obsidian);
            line-height: 1.08;
        }

        /* ==========================================================================
           6. SECTION III: THE COLLECTION PRODUCT GRID
           ========================================================================== */
        .collection-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: clamp(32px, 5vw, 64px);
        }

        @media (max-width: 820px) {
            .collection-grid {
                grid-template-columns: 1fr;
                max-width: 440px;
                margin: 0 auto;
            }
        }

        .product-plate {
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
        }

        .product-image-wrap {
            width: 100%;
            background: #F4F4F2;
            border: 1px solid var(--border-hairline);
            overflow: hidden;
            cursor: zoom-in;
            transition: border-color 0.3s ease;
        }

        .product-image-wrap:hover {
            border-color: var(--tf-gold);
        }

        .product-image-wrap img {
            width: 100%;
            aspect-ratio: 3 / 4;
            object-fit: cover;
            display: block;
            transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .product-image-wrap:hover img {
            transform: scale(1.03);
        }

        .product-index {
            margin-top: 24px;
            font-size: 9px;
            font-weight: 700;
            letter-spacing: 0.28em;
            color: var(--tf-gold);
        }

        .product-name {
            margin-top: 8px;
            font-size: 16px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.18em;
            color: var(--tf-obsidian);
        }

        .product-subtitle {
            margin-top: 6px;
            font-size: 9px;
            text-transform: uppercase;
            letter-spacing: 0.24em;
            color: var(--tf-muted);
        }

        .product-try-link {
            margin-top: 18px;
            font-size: 8px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.28em;
            color: var(--tf-obsidian);
            text-decoration: none;
            border-bottom: 1px solid var(--tf-gold);
            padding-bottom: 4px;
            transition: color 0.2s ease;
        }

        .product-try-link:hover {
            color: var(--tf-crimson);
        }

        /* ==========================================================================
           7. SECTION IV: DYNAMIC AUTO-SCROLLING CAMPAIGN & DIGITAL ADS MARQUEE
           ========================================================================== */
        .ads-section-wrap {
            border-top: 1px solid var(--border-hairline);
            padding: clamp(120px, 15vw, 210px) 0;
            background: var(--bg-pure);
            overflow: hidden;
        }

        .ads-header-row {
            max-width: 1240px;
            margin: 0 auto clamp(56px, 8vw, 88px) auto;
            padding: 0 clamp(24px, 6vw, 72px);
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            flex-wrap: wrap;
            gap: 24px;
        }

        .marquee-viewport {
            width: 100%;
            overflow: hidden;
            position: relative;
            cursor: grab;
        }

        .marquee-viewport:active {
            cursor: grabbing;
        }

        .marquee-track {
            display: flex;
            gap: clamp(28px, 4vw, 52px);
            width: max-content;
            will-change: transform;
        }

        .ad-slide {
            flex: 0 0 auto;
            width: clamp(270px, 31vw, 390px);
            display: flex;
            flex-direction: column;
        }

        .ad-mat {
            background: var(--bg-pure);
            border: 1px solid var(--border-hairline);
            padding: 14px;
            cursor: zoom-in;
            transition: border-color 0.3s ease;
        }

        .ad-mat:hover {
            border-color: var(--tf-gold);
        }

        .ad-mat img {
            width: 100%;
            aspect-ratio: 9 / 16;
            object-fit: cover;
            display: block;
            background: var(--tf-obsidian);
            pointer-events: none;
        }

        .ad-caption {
            margin-top: 18px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 9px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.22em;
        }

        .ad-caption span:first-child {
            color: var(--tf-obsidian);
        }

        .ad-caption span:last-child {
            color: var(--tf-gold);
        }

        /* ==========================================================================
           8. SECTION V: EXPERIMENTAL INTERACTIVE STUDIO (BOTTOM SECTION)
           ========================================================================== */
        .experimental-section {
            border-top: 1px solid var(--border-hairline);
            background: var(--bg-pure);
            padding-top: clamp(120px, 15vw, 210px);
        }

        .exp-stage {
            position: relative;
            width: 100%;
            min-height: 100vh;
            min-height: 100dvh;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            align-items: center;
            padding: clamp(72px, 10vh, 96px) 24px clamp(36px, 5vh, 56px);
            border-top: 1px solid var(--border-hairline);
            background: radial-gradient(circle at 50% 48%, #FFFFFF 0%, #FAF9F6 78%, #F3F2EE 100%);
            overflow: hidden;
            user-select: none;
            -webkit-user-select: none;
        }

        .exp-canvas {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            z-index: 2;
            touch-action: pan-y;
        }

        .exp-head {
            position: relative;
            z-index: 10;
            text-align: center;
            pointer-events: none;
        }

        .exp-index {
            font-size: 9px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.32em;
            color: var(--tf-gold);
            margin-bottom: 10px;
        }

        .exp-title {
            font-size: clamp(26px, 5vw, 56px);
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.14em;
            color: var(--tf-obsidian);
            line-height: 1.05;
        }

        .exp-sub {
            font-size: 9px;
            font-weight: 400;
            text-transform: uppercase;
            letter-spacing: 0.26em;
            color: var(--tf-muted);
            margin-top: 10px;
        }

        .exp-object-wrap {
            position: relative;
            z-index: 12;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .exp-object-wrap:hover {
            transform: translateY(-6px);
        }

        .exp-object-wrap:active {
            transform: scale(0.97);
        }

        .product-art {
            height: clamp(250px, 44vh, 390px);
            width: auto;
            overflow: visible;
            filter: drop-shadow(0 24px 36px rgba(0, 0, 0, 0.1));
            transition: transform 0.25s ease, filter 0.3s ease;
        }

        .exp-object-wrap:hover .product-art {
            filter: drop-shadow(0 30px 44px rgba(181, 154, 87, 0.22));
        }

        .nozzle-cap {
            transition: transform 0.12s cubic-bezier(0.2, 0.9, 0.3, 1);
        }

        .spraying .nozzle-cap {
            transform: translateY(7px);
        }

        .bullet-core {
            transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .retracted .bullet-core {
            transform: translateY(46px);
        }

        .exp-foot {
            position: relative;
            z-index: 12;
            text-align: center;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 12px;
        }

        .exp-notes {
            font-size: 9px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.24em;
            color: var(--tf-gold);
            min-height: 14px;
            opacity: 0.9;
        }

        .exp-controls {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
            justify-content: center;
        }

        .exp-btn {
            background: var(--tf-obsidian);
            color: var(--bg-pure);
            border: 1px solid var(--tf-obsidian);
            font-family: inherit;
            font-size: 9px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.24em;
            padding: 12px 24px;
            cursor: pointer;
            transition: all 0.25s ease;
        }

        .exp-btn:hover {
            background: var(--tf-gold);
            border-color: var(--tf-gold);
            color: var(--tf-obsidian);
        }

        .exp-btn.ghost {
            background: rgba(255, 255, 255, 0.92);
            color: var(--tf-obsidian);
            border: 1px solid var(--border-hairline);
        }

        .exp-btn.ghost:hover {
            border-color: var(--tf-crimson);
            color: var(--tf-crimson);
            background: rgba(255, 255, 255, 0.92);
        }

        .pigment-cursor {
            position: fixed;
            width: 14px;
            height: 14px;
            border-radius: 50%;
            border: 1px solid var(--tf-crimson);
            background: rgba(99, 0, 14, 0.16);
            pointer-events: none;
            z-index: 80;
            transform: translate(-50%, -50%);
            opacity: 0;
            transition: opacity 0.2s ease, width 0.2s ease, height 0.2s ease;
        }

        .pigment-cursor.visible {
            opacity: 1;
        }

        .pigment-cursor.sharp {
            width: 7px;
            height: 7px;
            background: var(--tf-crimson);
        }

        /* ==========================================================================
           9. FULL-SCREEN GALLERY LIGHTBOX & MINIMAL FOOTER
           ========================================================================== */
        .lightbox {
            position: fixed;
            inset: 0;
            z-index: 200;
            background: rgba(0, 0, 0, 0.96);
            display: none;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            padding: 32px 24px;
        }

        .lightbox.open {
            display: flex;
        }

        .lightbox-close {
            position: absolute;
            top: 28px;
            right: 32px;
            background: transparent;
            border: 1px solid var(--tf-gold);
            color: var(--bg-pure);
            font-family: inherit;
            font-size: 9px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.24em;
            padding: 10px 18px;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .lightbox-close:hover {
            background: var(--tf-gold);
            color: var(--tf-obsidian);
        }

        .lightbox img {
            max-width: 88vw;
            max-height: 78vh;
            object-fit: contain;
        }

        .lightbox-label {
            margin-top: 22px;
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.26em;
            color: var(--tf-gold);
        }

        .palette-strip {
            display: flex;
            height: 3px;
            width: 100%;
        }

        .palette-strip span {
            flex: 1;
        }

        .site-footer {
            text-align: center;
            padding: 64px 24px 88px;
            font-size: 9px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.28em;
            color: var(--tf-muted);
            background: var(--bg-pure);
        }
    </style>
</head>
<body>

    <!-- Minimal Sticky Header -->
    <nav class="site-nav" id="siteNav">
        <a href="#top" class="nav-brand">TOM FORD BEAUTY <span>INDISCREET</span></a>
        <div class="nav-links">
            <a href="#campaign-film">01 Campaign</a>
            <a href="#collection">02 Collection</a>
            <a href="#billboards">03 Digital &amp; OOH</a>
            <a href="#experimental">04 Interactive Studio</a>
        </div>
    </nav>

    <!-- ==========================================================================
         I. DYNAMIC HERO STAGE
         ========================================================================== -->
    <header class="hero-stage" id="top">
        <canvas id="heroFxCanvas"></canvas>
        <div class="hero-frame"></div>

        <div class="logo-lockup" id="logoLockup">
            <div class="logo-brand">TOM FORD</div>
            <h1 class="logo-sub" id="indiscreetWord">INDISCREET</h1>
        </div>

        <a href="#campaign-film" class="hero-scroll-link">Explore</a>
    </header>

    <!-- ==========================================================================
         II. STANDALONE FULL-SCREEN CAMPAIGN IMAGE (NO LABELS)
         ========================================================================== -->
    <section class="campaign-hero-media" id="campaign-film" data-lightbox="TOM FORD BEAUTY — INDISCREET">
        <img src="Gemini_Generated_Image_fig5kofig5kofig5.jpeg" alt="TOM FORD BEAUTY — INDISCREET" onerror="this.src='https://placehold.co/1920x1080/0A0A0C/B59A57?text=TOM+FORD+INDISCREET'">
    </section>

    <!-- ==========================================================================
         III. THE COLLECTION (ALL THREE INDISCREET PRODUCTS)
         ========================================================================== -->
    <section class="luxury-section" id="collection">
        <div class="section-header">
            <div class="section-kicker">01 &mdash; The Collection</div>
            <h2 class="section-heading">INDISCREET</h2>
        </div>

        <div class="collection-grid">
            <!-- 01. Eau de Parfum -->
            <article class="product-plate">
                <div class="product-image-wrap" data-lightbox="01 — INDISCREET EAU DE PARFUM">
                    <img src="Gemini_Generated_Image_e2l2rae2l2rae2l2.jpeg" alt="Indiscreet Eau de Parfum" onerror="this.src='https://placehold.co/900x1200/F4F4F2/000000?text=INDISCREET+EAU+DE+PARFUM'">
                </div>
                <div class="product-index">01</div>
                <h3 class="product-name">INDISCREET</h3>
                <div class="product-subtitle">Eau de Parfum</div>
                <a href="#exp-parfum" class="product-try-link">Experience</a>
            </article>

            <!-- 02. Lip Color -->
            <article class="product-plate">
                <div class="product-image-wrap" data-lightbox="02 — INDISCREET LIP COLOR">
                    <img src="Gemini_Generated_Image_3u41a63u41a63u41.jpeg" alt="Indiscreet Lip Color" onerror="this.src='https://placehold.co/900x1200/F4F4F2/63000E?text=INDISCREET+LIP+COLOR'">
                </div>
                <div class="product-index">02</div>
                <h3 class="product-name">INDISCREET</h3>
                <div class="product-subtitle">Lip Color</div>
                <a href="#exp-lipstick" class="product-try-link">Experience</a>
            </article>

            <!-- 03. Lip Pencil -->
            <article class="product-plate">
                <div class="product-image-wrap" data-lightbox="03 — INDISCREET LIP PENCIL">
                    <img src="Gemini_Generated_Image_2o5fdf2o5fdf2o5f.jpeg" alt="Indiscreet Lip Pencil" onerror="this.src='https://placehold.co/900x1200/F4F4F2/000000?text=INDISCREET+LIP+PENCIL'">
                </div>
                <div class="product-index">03</div>
                <h3 class="product-name">INDISCREET</h3>
                <div class="product-subtitle">Lip Pencil</div>
                <a href="#exp-pencil" class="product-try-link">Experience</a>
            </article>
        </div>
    </section>

    <!-- ==========================================================================
         IV. DYNAMIC AUTO-SCROLLING CAMPAIGN & DIGITAL ADS
         ========================================================================== -->
    <section class="ads-section-wrap" id="billboards">
        <div class="ads-header-row">
            <div>
                <div class="section-kicker">02 &mdash; Campaign &amp; Digital</div>
                <h2 class="section-heading">Out of Home &amp; Social</h2>
            </div>
        </div>

        <div class="marquee-viewport" id="marqueeViewport">
            <div class="marquee-track" id="marqueeTrack">
                <!-- Slide 01: Hero Billboard -->
                <article class="ad-slide">
                    <div class="ad-mat" data-lightbox="I. THE TRACE — BILLBOARD">
                        <img src="image_500b07.jpeg" alt="I. The Trace Billboard" onerror="this.src='https://placehold.co/900x1600/000000/B59A57?text=I.+THE+TRACE'">
                    </div>
                    <div class="ad-caption">
                        <span>I. The Trace</span>
                        <span>Billboard</span>
                    </div>
                </article>

                <!-- Slide 02: Second Billboard -->
                <article class="ad-slide">
                    <div class="ad-mat" data-lightbox="II. THE VEIL — BILLBOARD">
                        <img src="image_500b23.jpeg" alt="II. The Veil Billboard" onerror="this.src='https://placehold.co/900x1600/000000/B59A57?text=II.+THE+VEIL'">
                    </div>
                    <div class="ad-caption">
                        <span>II. The Veil</span>
                        <span>Billboard</span>
                    </div>
                </article>

