    <script>
        /* ==========================================================================
           1. STICKY NAV REVEAL
           ========================================================================== */
        const siteNav = document.getElementById('siteNav');
        window.addEventListener('scroll', () => {
            siteNav.classList.toggle('visible', window.scrollY > window.innerHeight * 0.65);
        }, { passive: true });

        /* ==========================================================================
           2. DYNAMIC HERO INTERACTION ENGINE (PARALLAX, GOLD LIGHT & CRIMSON TRACE)
           ========================================================================== */
        const heroStage = document.getElementById('top');
        const heroCanvas = document.getElementById('heroFxCanvas');
        const hCtx = heroCanvas.getContext('2d');
        const logoLockup = document.getElementById('logoLockup');
        const indiscreetWord = document.getElementById('indiscreetWord');

        let heroW = 0;
        let heroH = 0;

        const heroPointer = {
            x: window.innerWidth * 0.5,
            y: window.innerHeight * 0.5,
            targetX: window.innerWidth * 0.5,
            targetY: window.innerHeight * 0.5,
            prevX: null,
            prevY: null,
            isDown: false
        };

        const heroPulses = [];
        const heroTraces = [];

        function resizeHeroCanvas() {
            const dpr = Math.min(window.devicePixelRatio || 1, 2);
            heroW = heroStage.clientWidth;
            heroH = heroStage.clientHeight;
            heroCanvas.width = heroW * dpr;
            heroCanvas.height = heroH * dpr;
            hCtx.setTransform(dpr, 0, 0, dpr, 0, 0);
        }

        heroStage.addEventListener('pointermove', (e) => {
            const rect = heroStage.getBoundingClientRect();
            const x = e.clientX - rect.left;
            const y = e.clientY - rect.top;
            heroPointer.targetX = x;
            heroPointer.targetY = y;

            const pctX = (x / Math.max(1, heroW)) * 100;
            indiscreetWord.style.backgroundPosition = `${pctX}% 50%`;

            if (heroPointer.isDown && heroPointer.prevX !== null) {
                heroTraces.push({
                    x1: heroPointer.prevX,
                    y1: heroPointer.prevY,
                    x2: x,
                    y2: y,
                    alpha: 0.34
                });
            }
            heroPointer.prevX = x;
            heroPointer.prevY = y;
        }, { passive: true });

        heroStage.addEventListener('pointerdown', (e) => {
            const rect = heroStage.getBoundingClientRect();
            const x = e.clientX - rect.left;
            const y = e.clientY - rect.top;
            heroPointer.isDown = true;
            heroPointer.prevX = x;
            heroPointer.prevY = y;

            heroPulses.push({
                x: x,
                y: y,
                r: 6,
                maxR: Math.min(heroW, heroH) * 0.36,
                alpha: 0.42
            });
        });

        window.addEventListener('pointerup', () => {
            heroPointer.isDown = false;
            heroPointer.prevX = null;
            heroPointer.prevY = null;
        });

        function renderHeroLoop(time) {
            heroPointer.x += (heroPointer.targetX - heroPointer.x) * 0.08;
            heroPointer.y += (heroPointer.targetY - heroPointer.y) * 0.08;

            const nx = (heroPointer.x / Math.max(1, heroW)) - 0.5;
            const ny = (heroPointer.y / Math.max(1, heroH)) - 0.5;
            logoLockup.style.transform = `translate3d(${nx * -14}px, ${ny * -10}px, 0)`;

            hCtx.clearRect(0, 0, heroW, heroH);

            const spotGrad = hCtx.createRadialGradient(
                heroPointer.x, heroPointer.y, 0,
                heroPointer.x, heroPointer.y, Math.max(heroW, heroH) * 0.42
            );
            spotGrad.addColorStop(0, 'rgba(181, 154, 87, 0.11)');
            spotGrad.addColorStop(0.55, 'rgba(181, 154, 87, 0.03)');
            spotGrad.addColorStop(1, 'rgba(255, 255, 255, 0)');
            hCtx.fillStyle = spotGrad;
            hCtx.fillRect(0, 0, heroW, heroH);

            const drift = Math.sin(time * 0.0005) * (heroW * 0.12);
            const beamGrad = hCtx.createLinearGradient(heroW * 0.2 + drift, 0, heroW * 0.8 + drift, heroH);
            beamGrad.addColorStop(0, 'rgba(181, 154, 87, 0)');
            beamGrad.addColorStop(0.5, 'rgba(181, 154, 87, 0.055)');
            beamGrad.addColorStop(1, 'rgba(181, 154, 87, 0)');
            hCtx.fillStyle = beamGrad;
            hCtx.fillRect(0, 0, heroW, heroH);

            for (let i = heroTraces.length - 1; i >= 0; i--) {
                const s = heroTraces[i];
                s.alpha *= 0.992;
                if (s.alpha < 0.008) {
                    heroTraces.splice(i, 1);
                    continue;
                }
                hCtx.save();
                hCtx.lineCap = 'round';
                hCtx.strokeStyle = `rgba(99, 0, 14, ${s.alpha})`;
                hCtx.lineWidth = 14;
                hCtx.beginPath();
                hCtx.moveTo(s.x1, s.y1);
                hCtx.lineTo(s.x2, s.y2);
                hCtx.stroke();

                hCtx.strokeStyle = `rgba(65, 0, 9, ${s.alpha * 0.7})`;
                hCtx.lineWidth = 4;
                hCtx.beginPath();
                hCtx.moveTo(s.x1, s.y1);
                hCtx.lineTo(s.x2, s.y2);
                hCtx.stroke();
                hCtx.restore();
            }

            for (let i = heroPulses.length - 1; i >= 0; i--) {
                const p = heroPulses[i];
                p.r += (p.maxR - p.r) * 0.05;
                p.alpha *= 0.955;
                if (p.alpha < 0.01) {
                    heroPulses.splice(i, 1);
                    continue;
                }
                hCtx.beginPath();
                hCtx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
                hCtx.strokeStyle = `rgba(181, 154, 87, ${p.alpha})`;
                hCtx.lineWidth = 1;
                hCtx.stroke();
            }

            requestAnimationFrame(renderHeroLoop);
        }

        /* ==========================================================================
           3. DYNAMIC AUTO-SCROLLING CAMPAIGN & DIGITAL ADS MARQUEE
           ========================================================================== */
        const marqueeViewport = document.getElementById('marqueeViewport');
        const marqueeTrack = document.getElementById('marqueeTrack');
        const originalSlides = Array.from(marqueeTrack.children);
        originalSlides.forEach(slide => {
            const clone = slide.cloneNode(true);
            clone.setAttribute('aria-hidden', 'true');
            marqueeTrack.appendChild(clone);
        });

        let marqueeOffset = 0;
        let marqueePaused = false;
        let marqueeDragging = false;
        let marqueeDragStartX = 0;
        let marqueeDragStartOffset = 0;
        let marqueeMoved = false;

        marqueeViewport.addEventListener('mouseenter', () => { marqueePaused = true; });
        marqueeViewport.addEventListener('mouseleave', () => { marqueePaused = false; });

        marqueeViewport.addEventListener('pointerdown', (e) => {
            marqueeDragging = true;
            marqueeMoved = false;
            marqueeDragStartX = e.clientX;
            marqueeDragStartOffset = marqueeOffset;
        });

        window.addEventListener('pointermove', (e) => {
            if (!marqueeDragging) return;
            const dx = e.clientX - marqueeDragStartX;
            if (Math.abs(dx) > 5) marqueeMoved = true;
            marqueeOffset = marqueeDragStartOffset + dx;
        }, { passive: true });

        window.addEventListener('pointerup', () => {
            marqueeDragging = false;
        });

        function renderMarqueeLoop() {
            const halfWidth = marqueeTrack.scrollWidth / 2;
            if (!marqueePaused && !marqueeDragging && halfWidth > 0) {
                marqueeOffset -= 0.65;
            }
            if (halfWidth > 0) {
                while (marqueeOffset <= -halfWidth) marqueeOffset += halfWidth;
                while (marqueeOffset > 0) marqueeOffset -= halfWidth;
            }
            marqueeTrack.style.transform = `translate3d(${marqueeOffset}px, 0, 0)`;
            requestAnimationFrame(renderMarqueeLoop);
        }

        /* ==========================================================================
           4. FULL-SCREEN GALLERY LIGHTBOX
           ========================================================================== */
        const lightbox = document.getElementById('lightbox');
        const lbImg = document.getElementById('lbImg');
        const lbLabel = document.getElementById('lbLabel');
        const lbClose = document.getElementById('lbClose');

        function openLightbox(src, label) {
            lbImg.src = src;
            lbLabel.textContent = label;
            lightbox.classList.add('open');
            document.body.style.overflow = 'hidden';
        }

        function closeLightbox() {
            lightbox.classList.remove('open');
            document.body.style.overflow = '';
        }

        document.querySelectorAll('[data-lightbox]').forEach(el => {
            el.addEventListener('click', () => {
                if (marqueeMoved) return;
                const img = el.querySelector('img');
                if (img) openLightbox(img.src, el.dataset.lightbox);
            });
        });

        lbClose.addEventListener('click', closeLightbox);
        lightbox.addEventListener('click', e => {
            if (e.target === lightbox) closeLightbox();
        });
        document.addEventListener('keydown', e => {
            if (e.key === 'Escape' && lightbox.classList.contains('open')) closeLightbox();
        });

        /* ==========================================================================
           5. EXPERIMENTAL STUDIO: 01 PERFUME SPRAY MIST & TACTILE AUDIO
           ========================================================================== */
        let soundEnabled = false;
        let sprayNoise = null;
        let sprayFilter = null;

        const soundToggle = document.getElementById('soundToggle');
        soundToggle.addEventListener('click', async () => {
            soundEnabled = !soundEnabled;
            soundToggle.textContent = soundEnabled ? 'Sound: On' : 'Sound: Off';
            if (soundEnabled && typeof Tone !== 'undefined') {
                await Tone.start();
                if (!sprayNoise) {
                    sprayFilter = new Tone.Filter(2400, 'bandpass').toDestination();
                    sprayNoise = new Tone.NoiseSynth({
                        noise: { type: 'white' },
                        envelope: { attack: 0.015, decay: 0.22, sustain: 0, release: 0.1 }
                    }).connect(sprayFilter);
                    sprayNoise.volume.value = -14;
                }
            }
        });

        function playSpraySound() {
            if (!soundEnabled || !sprayNoise) return;
            try {
                sprayNoise.triggerAttackRelease('8n');
            } catch (e) {}
        }

        const parfumCanvas = document.getElementById('parfumCanvas');
        const pCtx = parfumCanvas.getContext('2d');
        const parfumTrigger = document.getElementById('parfumTrigger');
        const parfumSvg = document.getElementById('parfumSvg');
        const mistParticles = [];
        const mistRings = [];

        function resizeCanvasToParent(canvas, ctx) {
            const parent = canvas.parentElement;
            const dpr = Math.min(window.devicePixelRatio || 1, 2);
            canvas.width = parent.clientWidth * dpr;
            canvas.height = parent.clientHeight * dpr;
            ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        }

        function triggerPerfumeSpray() {
            const rect = parfumSvg.getBoundingClientRect();
            const stageRect = parfumCanvas.getBoundingClientRect();
            const originX = rect.left - stageRect.left + rect.width * 0.5;
            const originY = rect.top - stageRect.top + rect.height * 0.12;

            parfumSvg.classList.add('spraying');
            setTimeout(() => parfumSvg.classList.remove('spraying'), 180);

            playSpraySound();

            mistRings.push({
                x: originX,
                y: originY,
                radius: 8,
                maxRadius: Math.min(stageRect.width, stageRect.height) * 0.42,
                alpha: 0.35
            });

            for (let i = 0; i < 95; i++) {
                const spreadAngle = -Math.PI / 2 + (Math.random() - 0.5) * 1.45;
                const speed = 2.2 + Math.random() * 6.8;
                const isGold = Math.random() > 0.35;
                mistParticles.push({
                    x: originX + (Math.random() - 0.5) * 10,
                    y: originY + (Math.random() - 0.5) * 6,
                    vx: Math.cos(spreadAngle) * speed,
                    vy: Math.sin(spreadAngle) * speed,
                    radius: 1.2 + Math.random() * 3.8,
                    alpha: 0.45 + Math.random() * 0.45,
                    decay: 0.005 + Math.random() * 0.007,
                    color: isGold ? '181, 154, 87' : '99, 0, 14'
                });
            }
        }

        parfumTrigger.addEventListener('click', triggerPerfumeSpray);
        document.getElementById('sprayBtn').addEventListener('click', triggerPerfumeSpray);
        parfumCanvas.addEventListener('click', triggerPerfumeSpray);

        function renderMistLoop() {
            const w = parfumCanvas.parentElement.clientWidth;
            const h = parfumCanvas.parentElement.clientHeight;
            pCtx.clearRect(0, 0, w, h);

            for (let i = mistRings.length - 1; i >= 0; i--) {
                const r = mistRings[i];
                r.radius += (r.maxRadius - r.radius) * 0.055;
                r.alpha *= 0.94;
                pCtx.beginPath();
                pCtx.arc(r.x, r.y, r.radius, 0, Math.PI * 2);
                pCtx.strokeStyle = `rgba(181, 154, 87, ${r.alpha})`;
                pCtx.lineWidth = 1;
                pCtx.stroke();
                if (r.alpha < 0.01) mistRings.splice(i, 1);
            }

            for (let i = mistParticles.length - 1; i >= 0; i--) {
                const p = mistParticles[i];
                p.x += p.vx;
                p.y += p.vy;
                p.vx *= 0.955;
                p.vy *= 0.955;
                p.vy -= 0.015;
                p.radius += 0.08;
                p.alpha -= p.decay;

                if (p.alpha <= 0) {
                    mistParticles.splice(i, 1);
                    continue;
                }

                const g = pCtx.createRadialGradient(p.x, p.y, 0, p.x, p.y, p.radius * 2.2);
                g.addColorStop(0, `rgba(${p.color}, ${p.alpha})`);
                g.addColorStop(1, `rgba(${p.color}, 0)`);
                pCtx.fillStyle = g;
                pCtx.beginPath();
                pCtx.arc(p.x, p.y, p.radius * 2.2, 0, Math.PI * 2);
                pCtx.fill();
            }

            requestAnimationFrame(renderMistLoop);
        }

        /* ==========================================================================
           6. EXPERIMENTAL STUDIO: 02 LIPSTICK VELVET SWATCH
           ========================================================================== */
        const lipstickCanvas = document.getElementById('lipstickCanvas');
        const lCtx = lipstickCanvas.getContext('2d');
        const lipstickTrigger = document.getElementById('lipstickTrigger');
        const lipstickSvg = document.getElementById('lipstickSvg');
        let isDrawingLipstick = false;
        let lastLipPt = null;
        let lipRetracted = false;

        function paintVelvetStroke(x1, y1, x2, y2) {
            const dist = Math.hypot(x2 - x1, y2 - y1);
            const steps = Math.max(1, Math.floor(dist / 2.5));

            for (let i = 0; i <= steps; i++) {
                const t = i / steps;
                const x = x1 + (x2 - x1) * t;
                const y = y1 + (y2 - y1) * t;

                lCtx.save();
                lCtx.translate(x, y);
                lCtx.rotate(-0.38);

                lCtx.fillStyle = 'rgba(99, 0, 14, 0.24)';
                lCtx.beginPath();
                lCtx.ellipse(0, 0, 22, 9, 0, 0, Math.PI * 2);
                lCtx.fill();

                lCtx.fillStyle = 'rgba(65, 0, 9, 0.28)';
                lCtx.fillRect(-16, -2, 32, 1.5);
                lCtx.fillRect(-12, 3, 24, 1);

                lCtx.fillStyle = 'rgba(255, 255, 255, 0.14)';
                lCtx.beginPath();
                lCtx.ellipse(-4, -3, 10, 2, 0, 0, Math.PI * 2);
                lCtx.fill();

                lCtx.restore();
            }
        }

        function applyEditorialSwatchStroke() {
            if (lipRetracted) {
                lipRetracted = false;
                lipstickSvg.classList.remove('retracted');
            }
            const w = lipstickCanvas.parentElement.clientWidth;
            const h = lipstickCanvas.parentElement.clientHeight;
            const startX = w * (0.22 + Math.random() * 0.25);
            const startY = h * (0.34 + Math.random() * 0.34);
            const endX = startX + w * (0.26 + Math.random() * 0.16);
            const endY = startY + (Math.random() - 0.5) * 70;

            let progress = 0;
            let prevX = startX;
            let prevY = startY;

            function stepStroke() {
                progress += 0.08;
                const t = Math.min(1, progress);
                const ease = 1 - Math.pow(1 - t, 3);
                const curX = startX + (endX - startX) * ease;
                const curY = startY + (endY - startY) * ease + Math.sin(t * Math.PI) * 14;
                paintVelvetStroke(prevX, prevY, curX, curY);
                prevX = curX;
                prevY = curY;
                if (t < 1) requestAnimationFrame(stepStroke);
            }
            requestAnimationFrame(stepStroke);
        }

        lipstickCanvas.addEventListener('pointerdown', e => {
            if (lipRetracted) {
                lipRetracted = false;
                lipstickSvg.classList.remove('retracted');
            }
            const rect = lipstickCanvas.getBoundingClientRect();
            isDrawingLipstick = true;
            lastLipPt = { x: e.clientX - rect.left, y: e.clientY - rect.top };
            paintVelvetStroke(lastLipPt.x, lastLipPt.y, lastLipPt.x + 1, lastLipPt.y + 1);
        });

        lipstickCanvas.addEventListener('pointermove', e => {
            if (!isDrawingLipstick || !lastLipPt) return;
            const rect = lipstickCanvas.getBoundingClientRect();
            const pt = { x: e.clientX - rect.left, y: e.clientY - rect.top };
            paintVelvetStroke(lastLipPt.x, lastLipPt.y, pt.x, pt.y);
            lastLipPt = pt;
        });

        window.addEventListener('pointerup', () => {
            isDrawingLipstick = false;
            lastLipPt = null;
        });

        lipstickTrigger.addEventListener('click', applyEditorialSwatchStroke);
        document.getElementById('swatchBtn').addEventListener('click', applyEditorialSwatchStroke);

        document.getElementById('twistBtn').addEventListener('click', () => {
            lipRetracted = !lipRetracted;
            lipstickSvg.classList.toggle('retracted', lipRetracted);
        });

        document.getElementById('clearLipstickBtn').addEventListener('click', () => {
            const w = lipstickCanvas.parentElement.clientWidth;
            const h = lipstickCanvas.parentElement.clientHeight;
            lCtx.clearRect(0, 0, w, h);
        });

        /* ==========================================================================
           7. EXPERIMENTAL STUDIO: 03 LIP PENCIL CONTOUR LINE
           ========================================================================== */
        const pencilCanvas = document.getElementById('pencilCanvas');
        const cCtx = pencilCanvas.getContext('2d');
        const pencilTrigger = document.getElementById('pencilTrigger');
        let isDrawingPencil = false;
        let lastPenPt = null;

        function drawContourLine(x1, y1, x2, y2) {
            cCtx.save();
            cCtx.lineCap = 'round';
            cCtx.lineJoin = 'round';

            cCtx.strokeStyle = 'rgba(74, 4, 4, 0.88)';
            cCtx.lineWidth = 2.4;
            cCtx.beginPath();
            cCtx.moveTo(x1, y1);
            cCtx.lineTo(x2, y2);
            cCtx.stroke();

            cCtx.strokeStyle = 'rgba(99, 0, 14, 0.18)';
            cCtx.lineWidth = 5.5;
            cCtx.beginPath();
            cCtx.moveTo(x1, y1);
            cCtx.lineTo(x2, y2);
            cCtx.stroke();

            cCtx.restore();
        }

        function traceSignatureContour() {
            const w = pencilCanvas.parentElement.clientWidth;
            const h = pencilCanvas.parentElement.clientHeight;
            const cx = w * (0.28 + Math.random() * 0.44);
            const cy = h * (0.36 + Math.random() * 0.28);
            const scale = Math.min(w, h) * 0.16;

            const points = [];
            const totalSteps = 60;
            for (let i = 0; i <= totalSteps; i++) {
                const t = (i / totalSteps) * 2 - 1;
                const x = cx + t * scale;
                const bow = -Math.abs(Math.sin(t * Math.PI)) * (scale * 0.28) + (Math.cos(t * Math.PI * 2) * scale * 0.08);
                const y = cy + bow;
                points.push({ x, y });
            }

            let idx = 1;
            function stepContour() {
                if (idx >= points.length) return;
                drawContourLine(points[idx - 1].x, points[idx - 1].y, points[idx].x, points[idx].y);
                idx++;
                requestAnimationFrame(stepContour);
            }
            requestAnimationFrame(stepContour);
        }

        pencilCanvas.addEventListener('pointerdown', e => {
            const rect = pencilCanvas.getBoundingClientRect();
            isDrawingPencil = true;
            lastPenPt = { x: e.clientX - rect.left, y: e.clientY - rect.top };
            drawContourLine(lastPenPt.x, lastPenPt.y, lastPenPt.x + 0.5, lastPenPt.y + 0.5);
        });

        pencilCanvas.addEventListener('pointermove', e => {
            if (!isDrawingPencil || !lastPenPt) return;
            const rect = pencilCanvas.getBoundingClientRect();
            const pt = { x: e.clientX - rect.left, y: e.clientY - rect.top };
            drawContourLine(lastPenPt.x, lastPenPt.y, pt.x, pt.y);
            lastPenPt = pt;
        });

        window.addEventListener('pointerup', () => {
            isDrawingPencil = false;
            lastPenPt = null;
        });

        pencilTrigger.addEventListener('click', traceSignatureContour);
        document.getElementById('traceLineBtn').addEventListener('click', traceSignatureContour);

        document.getElementById('clearPencilBtn').addEventListener('click', () => {
            const w = pencilCanvas.parentElement.clientWidth;
            const h = pencilCanvas.parentElement.clientHeight;
            cCtx.clearRect(0, 0, w, h);
        });

        /* Custom Pigment Cursor on Swatch & Contour Stages */
        const pigmentCursor = document.getElementById('pigmentCursor');
        window.addEventListener('pointermove', e => {
            pigmentCursor.style.left = e.clientX + 'px';
            pigmentCursor.style.top = e.clientY + 'px';

            const overLip = e.target === lipstickCanvas;
            const overPen = e.target === pencilCanvas;

            pigmentCursor.classList.toggle('visible', overLip || overPen);
            pigmentCursor.classList.toggle('sharp', overPen);
        }, { passive: true });

        /* ==========================================================================
           8. INITIALIZATION & RESIZE HANDLER
           ========================================================================== */
        function handleResizeAll() {
            resizeHeroCanvas();
            resizeCanvasToParent(parfumCanvas, pCtx);
            resizeCanvasToParent(lipstickCanvas, lCtx);
            resizeCanvasToParent(pencilCanvas, cCtx);
        }

        window.addEventListener('resize', handleResizeAll);
        window.onload = function () {
            handleResizeAll();
            requestAnimationFrame(renderHeroLoop);
            requestAnimationFrame(renderMarqueeLoop);
            requestAnimationFrame(renderMistLoop);
        };
    </script>
</body>
</html>
